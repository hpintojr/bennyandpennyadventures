# Public site URL used for metadata, canonical links, and Stripe redirects
NEXT_PUBLIC_SITE_URL=https://bennyandpennyadventures.com

# Contact/newsletter placeholders. Wire these when Mailjet or another provider is ready.
NEXT_PUBLIC_CONTACT_EMAIL=hello@bennyandpenny.com
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Payload / database values. Never commit real values.
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=https://bennyandpennyadventures.com

# Stripe sandbox/test mode.
# Use pk_test_ on the client/public side.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Use rk_test_ if the restricted key has enough permissions for Checkout Sessions, Products, Prices, Customers, Payment Intents, and Webhook-created reads.
# If the restricted key does not have enough permissions during early development, temporarily use sk_test_ server-side only.
STRIPE_SECRET_KEY=

# Webhook signing secrets are separate from API keys and start with whsec_.
# Use the Stripe CLI whsec_ for local forwarding and the Dashboard endpoint whsec_ for deployed Vercel webhooks.
STRIPE_WEBHOOK_SECRET=
